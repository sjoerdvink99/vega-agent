        "title": {
          "type": "string"
        },
        "width": {
          "$ref": "#/definitions/Width"
        },
        "legend": {
          "type": "boolean"
        },
        "config": {
          "$ref": "#/definitions/ConfigSpec"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Param"
          }
        },
        "highlight": {
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "$ref": "#/definitions/ParamRef"
            }
          ]
        },
        "tooltip": {
          "$ref": "#/definitions/Tooltip"
        },
        "mark": {
          "type": "string",
          "const": "diagram"
