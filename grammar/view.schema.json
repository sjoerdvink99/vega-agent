        {
          "$ref": "#/definitions/HandoffsSpec"
        },
        {
          "$ref": "#/definitions/IcicleSpec"
        },
        {
          "$ref": "#/definitions/VariantsSpec"
        },
        {
          "$ref": "#/definitions/TransitionsSpec"
