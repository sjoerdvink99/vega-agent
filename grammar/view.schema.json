          "type": "string"
        },
        "size": {
          "$ref": "#/definitions/Size"
        },
        "advance": {
          "$ref": "#/definitions/Size"
        }
      },
      "additionalProperties": false
    },
    "Color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "Param": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/Name"
        },
        "select": {
          "type": "string",
          "enum": [
            "click",
            "hover"
