          "$ref": "#/definitions/ConfigSpec"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Param"
          }
        },
        "highlight": {
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "$ref": "#/definitions/ParamRef"
            }
          ]
        },
