    "Field": {
      "type": "string",
      "enum": [
        "actor",
        "count",
        "difference",
        "duration",
        "end",
        "ending",
        "failed",
        "from",
        "longest",
        "matching",
        "median",
        "rate",
        "run",
        "runs",
        "share",
        "spread",
        "start",
        "step",
        "steps"
      ]
    },
    "TimelineSpec": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/Data"
