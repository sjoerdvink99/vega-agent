        "$schema": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "width": {
          "$ref": "#/definitions/Width"
        },
        "legend": {
          "type": "boolean"
        },
        "config": {
          "$ref": "#/definitions/ConfigSpec"
        },
        "params": {
          "type": "array",
