        "muted": {
          "$ref": "#/definitions/Color"
        },
        "faint": {
          "$ref": "#/definitions/Color"
        },
        "line": {
          "$ref": "#/definitions/Color"
        },
        "panel": {
          "$ref": "#/definitions/Color"
        },
        "rail": {
          "$ref": "#/definitions/Color"
        },
        "fail": {
          "$ref": "#/definitions/Color"
        },
        "actors": {
          "type": "object",
          "properties": {
            "model": {
              "$ref": "#/definitions/Color"
