          "$ref": "#/definitions/Scalar"
        }
      },
      "required": [
        "field",
        "equal"
      ],
      "additionalProperties": false
    },
    "FieldName": {
      "type": "string",
      "minLength": 1,
      "description": "A field of the records, with dots reaching into nested objects."
    },
    "Scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "OneOfPredicate": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/definitions/FieldName"
