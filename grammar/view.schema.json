        "range": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "field",
        "range"
      ],
      "additionalProperties": false
    },
    "ValidPredicate": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/definitions/FieldName"
