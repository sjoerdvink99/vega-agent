    "Ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Expression": {
      "type": "string",
      "description": "An expression in the vega-agent process grammar."
    },
    "ParamRef": {
      "type": "object",
      "properties": {
        "param": {
          "$ref": "#/definitions/Name"
        }
      },
      "required": [
        "param"
      ],
      "additionalProperties": false
