        {
          "$ref": "#/definitions/DistributionSpec"
        },
        {
          "$ref": "#/definitions/DurationsSpec"
        },
        {
          "$ref": "#/definitions/ProjectionSpec"
        }
      ]
    },
    "DiagramSpec": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
