      },
      "required": [
        "field",
        "order"
      ],
      "additionalProperties": false
    },
    "ActorChannel": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/definitions/FieldName"
        },
        "map": {
          "type": "object",
