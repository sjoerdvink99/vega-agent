          }
        },
        "trace": {
          "$ref": "#/definitions/Mapping"
        },
        "$schema": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "width": {
          "$ref": "#/definitions/Width"
        },
        "legend": {
          "type": "boolean"
        },
