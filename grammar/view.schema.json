      "additionalProperties": false
    },
    "AndPredicate": {
      "type": "object",
      "properties": {
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Predicate"
          }
        }
      },
      "required": [
        "and"
      ],
      "additionalProperties": false
    },
    "OrPredicate": {
      "type": "object",
      "properties": {
        "or": {
