    {
      "name": "runs written as expressions",
      "trace": {
        "group": "arm"
      },
      "input": [
        "model",
        {
          "process": "model -> tool! -> model",
          "arm": "a",
          "id": "x",
          "time": [
            [
              0,
              1
            ],
            [
              1,
              2
            ],
            [
              2,
              3
            ]
          ]
        },
        {
          "process": "tool",
          "arm": 2
        },
        {
          "process": "model*",
          "arm": "a"
        },
        {
          "process": "tool -> model",
          "arm": "a",
          "time": [
            [
              0,
              1
            ]
          ]
        }
      ],
      "expected": [
        {
          "id": "x",
          "process": "model -> tool! -> model",
          "group": "a",
          "time": [
            [
              0,
              1
            ],
            [
              1,
              2
            ],
            [
              2,
              3
            ]
          ]
        },
        {
          "id": "1",
          "process": "tool -> model",
          "group": "a",
          "time": [
            null,
            null
          ]
        },
        {
          "id": "2",
          "process": "tool",
          "group": "2"
        }
      ]
    },
