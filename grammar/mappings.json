    {
      "name": "nested spans with units, overlap, failure, agent and groups",
      "trace": {
        "run": "trace",
        "step": "id",
        "parent": "parent",
        "actor": "type",
        "name": "name",
        "start": {
          "field": "start_ms",
          "unit": "ms"
        },
        "end": {
          "field": "end_ms",
          "unit": "ms"
        },
        "failed": {
          "field": "status",
          "equal": "error"
        },
        "group": "model"
      },
      "input": [
        {
          "trace": "a",
          "id": "1",
          "type": "invoke_agent",
          "name": "coder",
          "start_ms": 0,
          "end_ms": 900,
          "model": "gpt"
        },
        {
          "trace": "a",
          "id": "2",
          "parent": "1",
          "type": "chat",
          "start_ms": 0,
          "end_ms": 300
        },
        {
          "trace": "a",
          "id": "3",
          "parent": "1",
          "type": "execute_tool",
          "name": "edit",
          "status": "error",
          "start_ms": 300,
          "end_ms": 500
        },
        {
          "trace": "a",
          "id": "4",
          "parent": "1",
          "type": "execute_tool",
          "name": "test",
          "start_ms": 320,
          "end_ms": 600
        },
        {
          "trace": "a",
          "id": "5",
          "parent": "1",
          "type": "chat",
          "start_ms": 600,
          "end_ms": 900
        },
        {
          "trace": "b",
          "id": "6",
          "type": "chat",
          "start_ms": 0,
          "end_ms": 200,
          "model": "claude"
        },
        {
          "trace": "b",
          "id": "7",
          "type": "execute_tool",
          "name": "edit",
          "status": "ok",
          "start_ms": 200,
          "end_ms": 400
